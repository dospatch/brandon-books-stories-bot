{
  "id": "./",
  "name": "Brandon Books & Stories",
  "short_name": "Brandon Books",
  "description": "The official bookstore and author experience of Brandon D. Coleman Jr.",
  "lang": "en-US",
  "start_url": "./?source=installed-app",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#171513",
  "background_color": "#f7f4ef",
  "categories": [
    "books",
    "shopping",
    "lifestyle"
  ],
  "icons": [
    {
      "src": "assets/bbs-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/bbs-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/bbs-app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}